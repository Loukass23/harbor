# Copy to .env.local (gitignored). Vite reads it for dev and desktop builds.

# Harbor's own servers (harbor.site, sync/app/bugs.harbor.site) are shut down.
# Features backed by them stay off, and nothing is sent to them, unless "on".
VITE_HARBOR_HOSTED=off
# The in-app updater stays off unless "on" (its feed at harbor.site is gone).
VITE_HARBOR_UPDATER=off

# Point a hosted feature at a replacement server. Each override wins over
# VITE_HARBOR_HOSTED=off. Leave empty to keep the feature off.
VITE_HARBOR_API_BASE=
VITE_HARBOR_TRAKT_BASE=
VITE_HARBOR_MAL_BASE=
VITE_HARBOR_TVDB_BASE=
VITE_HARBOR_BUGS_BASE=
VITE_HARBOR_SYNC_BASE=
VITE_HARBOR_RELAY_BASE=
