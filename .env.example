# Harbor Environment Configuration Example
# Copy this file to .env and adjust variables to match your environment.

# ==========================================
# Samsung Tizen TV Deployment & Diagnostics
# ==========================================

# Target device name or IP/DUID as seen by Tizen CLI / SDB (defaults to auto-detection from 'sdb devices')
HARBOR_TIZEN_TARGET=GU43DU7199UXZG

# SDB serial address for Wi-Fi or USB connected TV (defaults to auto-detection, e.g. 192.168.178.26:26101)
HARBOR_TIZEN_SERIAL=192.168.178.26:26101

# Tizen certificate profile for signing the package (defaults to SwormHarbor or active tizen security profile)
HARBOR_TIZEN_PROFILE=SwormHarbor

# Chrome DevTools Protocol (CDP) port for diagnostics and live seeding (defaults to auto-detection from 'sdb forward --list')
# HARBOR_CDP_PORT=45159

# Custom .harbx or .json backup file path to use for dev seeding
# HARBOR_TIZEN_BACKUP=harbor-backups/my-backup.harbx

# ==========================================
# Desktop / Webview Development
# ==========================================

# Port for desktop Webview2 remote debugging
# WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=45159
