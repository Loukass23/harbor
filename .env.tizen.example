# Copy to .env.tizen (gitignored) and fill in. Read by scripts/tizen.mjs.

# 10 alphanumeric characters. Install fails with [118,-4] otherwise.
HARBOR_TIZEN_PACKAGE_ID=
# Samsung certificate profile name from Tizen Studio's Certificate Manager.
# The TV's DUID must be included in the distributor certificate.
HARBOR_TIZEN_PROFILE=
# sdb serial of the TV, for example 192.168.1.50:26101. Empty means use the only connected device.
HARBOR_TIZEN_SERIAL=
# Optional companion (desktop Harbor or Stremio server) used during development.
HARBOR_TIZEN_COMPANION_URL=
