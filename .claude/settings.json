{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run check:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run build:tizen:*)",
      "Bash(node scripts/check-tizen-boundary.mjs:*)",
      "Bash(node scripts/tizen.mjs:*)",
      "Bash(sdb devices)",
      "Bash(sdb connect:*)",
      "Bash(sdb forward:*)",
      "Bash(sdb dlog:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(tsc -b:*)",
      "Bash(npx tsc -b:*)",
      "Bash(sdb shell rm:*)",
      "Read(.env.tizen)",
      "Edit(.env.tizen)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/tizen-boundary.mjs\""
          }
        ]
      }
    ]
  }
}
